{
  "name": "kavach",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
