# syntax=docker/dockerfile:1
FROM kavach-builder AS assets
FROM nginxinc/nginx-unprivileged:1.28-alpine
ENV PORT=8081 RELEASE_SHA=development
ENV NGINX_ENVSUBST_FILTER="^(PORT|API_ORIGIN|RELEASE_SHA)$"
COPY --from=assets --chown=101:101 /app/apps/web/dist /usr/share/nginx/html
COPY --chown=101:101 --chmod=644 infra/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY --chown=101:101 --chmod=644 infra/web/runtime-config.js.template /etc/nginx/templates/runtime-config.js.template
RUN chmod 755 /etc/nginx/templates
COPY --chmod=755 infra/web/19-validate-config.sh /docker-entrypoint.d/19-validate-config.sh
EXPOSE 8081
