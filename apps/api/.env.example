# Copy to apps/api/.env for local development; no cloud account required.
APP_ENV=local
PORT=8080
# Exact frontend origin permitted by CORS and CSRF. Hono never serves web assets.
APP_ORIGIN=http://localhost:3000
STORAGE_BACKEND=sqlite
# Relative to repository root, independent of the server's working directory.
SQLITE_PATH=.data/kavach.sqlite
WEATHER_PROVIDER=disabled
SESSION_TTL_SECONDS=86400

# Firestore emulator alternative (no real project needed):
# STORAGE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=demo-kavach
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIRESTORE_DATABASE_ID=(default)

# GCP later: APP_ENV=production, STORAGE_BACKEND=firestore,
# GOOGLE_CLOUD_PROJECT=<real-project>, APP_ORIGIN=https://<web-service-host>
# Leave FIRESTORE_EMULATOR_HOST unset; use Cloud Run workload identity.
# OPEN_METEO_API_KEY is a server-only commercial key if applicable.

# Optional Google voice and grounded explanations, all server-only.
EXPLANATION_PROVIDER=disabled
GOOGLE_MODEL_ID=gemini-3.6-flash
GOOGLE_CLOUD_LOCATION=global
SPEECH_LOCATION=us
# Local opt-in uses short-lived authenticated gcloud CLI credentials. Rejected in production.
LOCAL_GCLOUD_AUTH=false
DEMO_AI_REQUESTS_PER_MINUTE=10
DEMO_AI_REQUESTS_PER_DAY=100
DEMO_STT_SECONDS_PER_MINUTE=300
DEMO_STT_SECONDS_PER_DAY=3000
DEMO_TTS_CHARS_PER_MINUTE=12000
DEMO_TTS_CHARS_PER_DAY=120000
